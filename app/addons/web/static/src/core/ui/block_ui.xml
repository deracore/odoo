<?xml version="1.0"?>
<templates>
<t t-name="web.BlockUI">
    <t t-if="state.blockState === BLOCK_STATES.UNBLOCKED">
        <div/>
    </t>
    <t t-else="">
        <t t-set="visiblyBlocked" t-value="state.blockState === BLOCK_STATES.VISIBLY_BLOCKED"/>
        <div class="app_blockUI fixed-top d-flex justify-content-center align-items-center flex-column vh-100"
                t-att-class="visiblyBlocked ? '' : 'app_blockUI_invisible'">
            <t t-if="visiblyBlocked">
                <div class="app_spinner mb-4">
                    <img src="/web/static/img/spin.svg" alt="Loading..."/>
                </div>
                <div class="app_message text-center px-4">
                    <t t-esc="state.line1"/><br/>
                    <t t-esc="state.line2"/>
                </div>
            </t>
        </div>
    </t>
</t>
</templates>
